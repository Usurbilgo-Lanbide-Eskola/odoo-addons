<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Faculty Importer Wizard Form View -->
        <record id="view_faculty_importer_form" model="ir.ui.view">
            <field name="name">faculty.importer.form</field>
            <field name="model">faculty.importer</field>
            <field name="arch" type="xml">
                <form string="Import Faculties">
                    <sheet>
                        <group>
                            <group>
                                <field name="filename" invisible="1"/>
                                <field name="template_filename" invisible="1"/>
                                <field name="file" filename="filename"/>
                                <field name="override"/>
                            </group>
                        </group>
                        <group>
                            <button name="action_download_template" 
                                    string="Download Template" 
                                    type="object" 
                                    class="btn-link"
                                    icon="fa-download"/>
                        </group>
                        <notebook>
                            <page string="Instructions">
                                <group>
                                    <div class="alert alert-info">
                                        <h4>Import Instructions</h4>
                                        <ol>
                                            <li>Download the Excel template using the button above</li>
                                            <li>Fill in the faculty data in the template</li>
                                            <li>Save the file and upload it using the "Excel File" field</li>
                                            <li>Check "Override Existing Data" if you want to update existing faculties</li>
                                            <li>Click "Import Faculties" to process the file</li>
                                        </ol>
                                        
                                        <h5>Required Columns:</h5>
                                        <ul>
                                            <li><strong>lastname:</strong> Faculty last name (required)</li>
                                            <li><strong>second_lastname:</strong> Second last name (optional)</li>
                                            <li><strong>name:</strong> First name (required)</li>
                                            <li><strong>id:</strong> ID/Document number (required)</li>
                                            <li><strong>birthdate:</strong> Birth date in YYYY-MM-DD format (optional)</li>
                                            <li><strong>workload:</strong> Position workload (optional)</li>
                                            <li><strong>speciality:</strong> Speciality code (optional)</li>
                                        </ul>

                                        <h5>Workload Options:</h5>
                                        <ul>
                                            <li><code>full</code> - Full-Time</li>
                                            <li><code>one-third</code> - 1/3</li>
                                            <li><code>half</code> - 1/2</li>
                                            <li><code>two-thirds</code> - 2/3</li>
                                            <li><code>five-sixths</code> - 5/6</li>
                                        </ul>

                                        <p><strong>Note:</strong> The template includes reference sheets with all available speciality codes and workload options.</p>
                                    </div>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_import_faculties" 
                                string="Import Faculties" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Faculty Importer Wizard Action -->
        <record id="action_faculty_importer" model="ir.actions.act_window">
            <field name="name">Import Faculties</field>
            <field name="res_model">faculty.importer</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_faculty_importer"
                  name="Import Faculties"
                  parent="hezkuntza_student_importer.hezkuntza_importer"
                  action="action_faculty_importer"
                  sequence="100"/>
    </data>
</odoo>
