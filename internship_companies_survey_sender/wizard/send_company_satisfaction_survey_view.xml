<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_send_company_satisfaction_survey_form" model="ir.ui.view">
        <field name="name">view.send.company.internship.form</field>
        <field name="model">send.company.satisfaction.survey</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="survey.survey_invite_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='survey_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="string">Template Survey</attribute>
                <attribute name="domain">[('survey_template', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='survey_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='survey_id']" position="after">
                <field name="school_year" />
                <field name="satisfaction_line_ids">
                    <tree editable="1" delete="0" create="0">
                        <field name="internship_type_id" />
                        <field name="survey_id" />
                    </tree>
                </field>
            </xpath>
            <xpath expr="//field[@name='survey_start_url']" position="attributes">
                <attribute name="attrs">{'invisible': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="attrs">{'invisible': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='emails']" position="attributes">
                <attribute name="attrs">{'invisible': True}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_invite']" position="replace">
                <button string="Send" name="action_invite_instructors" type="object"
                    class="btn-primary" />
            </xpath>
        </field>
    </record>

    <record id="action_send_company_satisfaction_survey" model="ir.actions.act_window">
        <field name="name">Send Surveys to Instructors</field>
        <field name="res_model">send.company.satisfaction.survey</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_send_company_satisfaction_survey_form" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="company_internships.model_school_year_historical" />
        <field name="binding_view_types">list</field>
        <field name="context"
            eval="{
                'default_template_id': ref('mail_template_instructor_invite'),
                'default_use_template': bool(ref('mail_template_instructor_invite')),
                'notif_layout': 'mail.mail_notification_light',
                }" />
    </record>
</odoo>