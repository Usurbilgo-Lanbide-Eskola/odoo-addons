<odoo>
    <data>
        <!-- Inherit the ir.attachment form view -->
        <record id="view_ir_attachment_form_inherit_signatures" model="ir.ui.view">
            <field name="name">ir.attachment.form.inherit.signatures</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='datas']" position="after">
                    <field name="signature_line_ids" context="{'default_file_id': active_id}" attrs="{'invisible':[('mimetype', '!=', 'application/pdf')]}">
                        <tree>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="cert_issuer"  optional="hide"/>
                            <field name="cert_not_before"  optional="hide"/>
                            <field name="cert_not_after"  optional="hide"/>
                            <field name="cert_common_name"  optional="hide"/>
                            <field name="cert_serial_number"  optional="show"/>
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>

        <!-- Inherit the ir.attachment tree view -->
        <record id="view_ir_attachment_tree_inherit_signatures" model="ir.ui.view">
            <field name="name">ir.attachment.tree.inherit.signatures</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="signature_line_ids" widget="many2many_tags"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
