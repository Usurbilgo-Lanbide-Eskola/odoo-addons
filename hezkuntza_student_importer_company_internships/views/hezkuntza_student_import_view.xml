<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hezkuntza_student_import_delete_rejected_form" model="ir.ui.view">
        <field name="name">view.hezkuntza.student.import.delete.rejected.form</field>
        <field name="model">hezkuntza.student.import</field>
        <field name="inherit_id" ref="hezkuntza_student_importer.view_hezkuntza_student_import_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='overwrite']" position="after">
                <button name="delete_rejected_students" string="Delete Rejected" type="object" class="btn-danger"
                        help="The students who have been rejected and do not have any historical record will be eliminated"/>
            </xpath>
        </field>
    </record>
</odoo>