<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit tree view for internship.line -->
    <record id="view_internship_line_tree_speciality" model="ir.ui.view">
        <field name="name">internship.line.tree.speciality</field>
        <field name="model">internship.line</field>
        <field name="inherit_id" ref="company_internships.view_internship_line_tree"/>
        <field name="arch" type="xml">
            <field name="student_group_id" position="after">
                <field name="speciality_id"/>
            </field>
        </field>
    </record>

    <!-- Inherit form view for internship.line -->
    <record id="view_internship_line_form_speciality" model="ir.ui.view">
        <field name="name">internship.line.form.speciality</field>
        <field name="model">internship.line</field>
        <field name="inherit_id" ref="company_internships.view_internship_line_form"/>
        <field name="arch" type="xml">
            <field name="student_group_id" position="after">
                <field name="speciality_id"/>
            </field>
        </field>
    </record>

    <!-- Inherit search view for internship.line -->
    <record id="view_internship_line_search_speciality" model="ir.ui.view">
        <field name="name">internship.line.search.speciality</field>
        <field name="model">internship.line</field>
        <field name="inherit_id" ref="company_internships.view_internship_line_search"/>
        <field name="arch" type="xml">
            <field name="student_group_id" position="after">
                <field name="speciality_id"/>
            </field>
            <filter name="group_by_student_group" position="after">
                <filter name="group_by_speciality" string="Speciality" context="{'group_by': 'speciality_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
