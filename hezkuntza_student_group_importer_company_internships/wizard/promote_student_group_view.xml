<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="promote_student_group_view_form" model="ir.ui.view">
        <field name="name">promote.student.group.view.form</field>
        <field name="model">promote.student.group</field>
        <field name="arch" type="xml">
            <form string="Promote Student Group">
                <sheet>
                    <group>
                        <field name="school_year_id"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Promote" type="object" name="action_promote" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_promote_student_group" model="ir.actions.act_window">
        <field name="name">Promote Student Group</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="view_id" ref="promote_student_group_view_form"/>
        <field name="res_model">promote.student.group</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
