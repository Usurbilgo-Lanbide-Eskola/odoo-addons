<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_internship_prediction_line_tree" model="ir.ui.view">
        <field name="name">internship.prediction.line.tree</field>
        <field name="model">internship.prediction.line</field>
        <field name="arch" type="xml">
            <tree string="Internship Prediction Lines" editable="bottom"
                  decoration-danger="company_assignable_qty &lt; 0">
                <field name="student_small_image" widget="image" class="oe_avatar"
                    options='{"size": [0, 40]}' />
                <field name="school_year_historical_id" invisible="1" />
                <field name="student_id" />
                <field name="age" />
                <field name="driving_license" />
                <field name="car_owned" />
                <field name="city" />
                <field name="student_company_id"
                    domain="[('id', 'in', group_possible_company_ids)]" />
                <field name="button_lines_info" invisible="1"/>
                <button name="button_read_company_internship_lines_info" title="button_lines_info" type="object" icon="fa-info-circle" />
                <field name="company_assignable_qty" />
                <field name="company_city" />
                <field name="delivery_address_id"
                    domain="[('id', 'child_of', student_company_id), ('type', '=', 'delivery')]" />
                <field name="delivery_city" />
                <field name="group_possible_company_ids" invisible="1" />
                <field name="group_id" />
                <field name="record_company_id" />
            </tree>
        </field>
    </record>

    <record id="action_internship_prediction_line" model="ir.actions.act_window">
        <field name="name">Prediction Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">internship.prediction.line</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Internship Prediction Line
            </p>
        </field>
    </record>

    <menuitem id="menu_internship_prediction_line"
        name="Prediction Lines"
        action="action_internship_prediction_line"
        parent="menu_internships_root"
        sequence="20" />

</odoo>