<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_internships_crm_settings_form" model="ir.ui.view">
        <field name="name">view.company_internship.crm.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='generate_lead_setting_container']" position="after">
            <h2>Company Internships</h2>
            <div class="row mt16 o_settings_container">
                <div class=" col-12 col-lg-6 o_setting_box" id="company_internships_settings">
                    <div class="o_setting_right_pane">
                        <b>Compute Students Opportunities</b>
                            <div class="text-muted">
                                CRM Stages to Compute Students Opportunities
                            </div>                        
                        <field name="crm_stage_ids" widget="many2many_tags"/>
                    </div>
                </div>
            </div>
            </xpath>
        </field>
    </record>
</odoo>
