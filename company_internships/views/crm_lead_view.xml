<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_quick_form_internship" model="ir.ui.view">
        <field name="name">crm.lead.quick.form.internship</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[("is_student", "=", False), ("is_tutor", "=", False)]</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="internship_sale_id" />
                <field name="internship_sale_ids" />
                <field name="opportunity_type" />
                <field name="school_year_id" invisible="0" />
                <field name="internship_line_ids"
                    attrs="{'invisible': [('opportunity_type', '!=', 'internship')]}"
                    nolabel="1">
                    <tree editable="top">
                        <field name="student_group_id" />
                        <field name="student_qty" />
                    </tree>
                    <form>
                        <field name="student_group_id" />
                        <field name="student_qty" />
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers" />
                            <field name="activity_ids" />
                            <field name="message_ids" widget="mail_thread" />
                        </div>
                    </form>
                </field>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_form_internship" model="ir.ui.view">
        <field name="name">crm.lead.form.internship</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', ('type', '=', 'lead'), '&amp;',
                    ('opportunity_type', '=', 'internship'), ('internship_sale_ids', '!=', []),
                    '&amp;', ('probability', '=', 0), ('active', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button string="Partial Won" type="action"
                    name="%(company_internships.action_crm_internship_partial_move)d"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('opportunity_type', '!=', 'internship'), ('probability', '=', 100)]}" />
                <button string="Open Quotation" name="open_quotation" type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('opportunity_type', '!=', 'internship'), ('internship_sale_ids', '=', [])]}" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[("is_student", "=", False), ("is_tutor", "=", False)]</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_info']" position="after">
                <group colspan="4" col="6">
                    <group colspan="2">
                        <field name="internship_sale_id" invisible="1" />
                        <field name="internship_sale_ids" invisible="1" />
                        <field name="opportunity_type" />
                        <field name="school_year_id" />
                    </group>
                    <group colspan="4">
                        <field name="internship_line_ids"
                            attrs="{'invisible': [('opportunity_type', '!=', 'internship')]}"
                            nolabel="1">
                            <tree editable="top">
                                <field name="student_group_id"
                                    domain="[('school_year_id', '=', parent.school_year_id)]" />
                                <field name="student_qty" />
                            </tree>
                        </field>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_lead_tree_internship" model="ir.ui.view">
        <field name="name">view.lead.tree.internship</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="internship_lines_students_qty" sum="Total Students" />
            </xpath>
        </field>
    </record>

    <record id="view_lead_with_order_search" model="ir.ui.view">
        <field name="name">lead.with.orders</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='won']" position="before">
                <filter name="working" string="Working"
                    domain="[('probability', '&lt;', 100), ('probability', '&gt;', 0), ]" />
            </xpath>
            <xpath expr="//filter[@name='open_opportunities']" position="after">
                <field name="allowed_group_ids"
                    filter_domain="[('allowed_group_ids.name', 'ilike', self)]"
                    string="Student Group" />
                <field name="school_year_id"
                    filter_domain="[('allowed_group_ids.school_year_id.name', 'ilike', self)]"
                    string="School Year" />
                <filter name="current_school_year" string="Current School Year"
                    domain="[('school_year_id.current_active_year', '=', True)]" />
                <separator />
                <filter name="no_order_leads" domain="[('order_ids', '!=', False)]"
                    string="No Order Leads" />
            </xpath>

        </field>
    </record>

    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_type': 'opportunity',
            'search_default_assigned_to_me': 1,
            'search_default_current_school_year': 1}
        </field>

    </record>

</odoo>