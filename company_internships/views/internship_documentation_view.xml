<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_documentation_form" model="ir.ui.view">
            <field name="name">internship.documentation.form</field>
            <field name="model">internship.documentation</field>
            <field name="arch" type="xml">
                <form string="Internship Documentation">
                    <field name="no_signed"/>
                    <field name="school_signed"/>
                    <field name="second_party_signed"/>
                    <field name="documentation_type"/>
                    <field name="signed"/>
                </form>
            </field>
        </record>
        <record id="view_internship_documentation_tree" model="ir.ui.view">
            <field name="name">internship.documentation.tree</field>
            <field name="model">internship.documentation</field>
            <field name="arch" type="xml">
                <form string="Internship Documentation">
                    <field name="no_signed"/>
                    <field name="school_signed"/>
                    <field name="second_party_signed"/>
                    <field name="documentation_type"/>
                    <field name="signed"/>
                </form>
            </field>
        </record>
</odoo>