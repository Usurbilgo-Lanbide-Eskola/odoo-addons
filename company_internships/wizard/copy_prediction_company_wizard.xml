<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_prediction_copy_wizard_form" model="ir.ui.view">
        <field name="name">internship.prediction.copy.wizard.form</field>
        <field name="model">internship.prediction.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Companies">
                <group>
                    <div class="alert alert-warning" role="alert" style="margin-bottom:0px;">
                        The selected students' records will be updated with the companies assigned
                        in the prediction lines.
                        This action cannot be undone immediately.
                    </div>
                </group>
                <group>
                    <field name="line_ids" readonly="1">
                        <tree
                            decoration-success="student_company_id == record_company_id or not record_company_id"
                            decoration-danger="student_company_id != record_company_id and record_company_id">
                            <field name="student_small_image" widget="image" class="oe_avatar"
                                options='{"size": [0, 40]}' />
                            <field name="student_id" />
                            <field name="student_company_id" />
                            <field name="record_company_id" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_copy_companies" string="Confirm" type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_internship_prediction_copy_wizard" model="ir.actions.act_window">
        <field name="name">Copy Companies to Student Records</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">internship.prediction.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_internship_prediction_copy_wizard_form" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_internship_prediction_line" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>