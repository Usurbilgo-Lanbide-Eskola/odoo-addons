<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resignation_wizard_form" model="ir.ui.view">
        <field name="name">resignation.wizard.form</field>
        <field name="model">resignation.wizard</field>
        <field name="arch" type="xml">
            <form string="Resignation Reason">
                <group>
                    <field name="reason" />
                </group>
                <footer>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>