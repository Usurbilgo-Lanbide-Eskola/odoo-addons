<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_workspace_settings_form" model="ir.ui.view">
        <field name="name">google.workspace.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="google_workspace_setting">
                    <div class="o_setting_right_pane">
                        <field name="credentials_file"/>
                        <field name="scope"/>
                        <field name="delegated_credentials"/>
                        <field name="password_model"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
