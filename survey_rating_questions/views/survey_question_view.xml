<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rating_question_form" model="ir.ui.view">
        <field name="name">view.rating.question.form</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml">
            <field name="matrix_subtype" position="after">
                <field name="is_rating_question" attrs="{'invisible': [('question_type', '!=', 'simple_choice')]}"/>
            </field>
        </field>
    </record>
    <record id="action_compute_rating" model="ir.actions.server">
        <field name="name">Compute Rating</field>
        <field name="model_id" ref="survey.model_survey_user_input"/>
        <field name="binding_model_id" ref="survey.model_survey_user_input"/>
        <field name="binding_view_types">list</field>        
        <field name="state">code</field>
        <field name="code">
            for record in records:
                record._compute_scoring_values()
        </field>
    </record>
</odoo>